---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---
<div class="phone">
  <div class="phone-screen">
    <Image src={src} alt={alt} widths={[300, 600]} sizes="300px" loading={eager ? 'eager' : 'lazy'} />
  </div>
</div>
