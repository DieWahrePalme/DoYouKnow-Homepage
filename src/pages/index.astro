---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import SupportButton from '../components/SupportButton.astro';
import PhoneShot from '../components/PhoneShot.astro';
import homeShot from '../assets/screens/03-home.png';
import swipeShot from '../assets/screens/04-swipe-card.png';
import draggingShot from '../assets/screens/05-swipe-dragging.png';
import resultShot from '../assets/screens/06-result.png';
import overviewShot from '../assets/screens/07-card-overview.png';
import streaksShot from '../assets/screens/03b-home-friends.png';
import matchShot from '../assets/screens/09-match-detail.png';
import friendsShot from '../assets/screens/12-friends.png';
import { TESTFLIGHT_URL, WEB_APP_URL, SITE_URL } from '../data/links';

const steps = [
  { title: 'Answer your daily card', text: 'One question about you, every day. Pick the answer that fits.' },
  { title: 'Guess your friends', text: 'See how well you know them, then find out how they really answered.' },
  { title: 'Keep the streak', text: 'Play daily, keep your flame alive and watch how you change over time.' },
];
const plans = [
  { name: 'Starter', text: 'Everything you need to play daily with friends.' },
  { name: 'Medium', text: 'More cards and more ways to compare with friends.' },
  { name: 'Pro', text: 'The full DoYouKnow experience.' },
];
const screens = [
  { src: swipeShot, title: 'Swipe to answer', text: 'A daily card, four answers from No to Yes.', alt: 'A question card with answer buttons' },
  { src: draggingShot, title: 'Go with your gut', text: 'Drag the card and it picks your answer.', alt: 'A card being swiped with an answer stamp' },
  { src: resultShot, title: 'See how well you guessed', text: 'Your score for each friend, answer by answer.', alt: 'Result screen showing 4 of 5 guessed right' },
  { src: overviewShot, title: 'And how well they know you', text: 'See how your friends guessed your answers.', alt: 'Overview of your answered card with friends\' guesses' },
  { src: streaksShot, title: 'Keep the streak', text: 'Flames show who plays every day.', alt: 'Home screen with friends and their streaks' },
  { src: matchShot, title: 'Check your match', text: 'How often you and a friend answer the same.', alt: 'Match with a friend, 90 percent, per category' },
  { src: friendsShot, title: 'Play with friends', text: 'Add friends and play together every day.', alt: 'Friends list with streaks' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DoYouKnow',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS, Web',
  url: SITE_URL,
  description: 'Answer daily questions about yourself, guess how your friends answered and keep your streak.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: 'Moritz Götz' },
};
---
<Base
  title="DoYouKnow – the daily game of knowing your friends"
  description="Answer daily questions about yourself, guess how your friends answered and keep your streak. Free during the beta."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Daily game · free in beta</p>
        <h1>How well do you <span class="grad">know</span> your friends?</h1>
        <p class="lead">Answer daily questions about yourself, guess how your friends answered, and keep your streak.</p>
        <div class="btn-row">
          {TESTFLIGHT_URL
            ? <a class="btn btn-primary" href={TESTFLIGHT_URL}>Join the beta</a>
            : <a class="btn btn-primary" href="#faq" aria-describedby="beta-note">Join the beta</a>}
          <a class="btn" href={WEB_APP_URL}>Play in the browser</a>
        </div>
        {!TESTFLIGHT_URL && <p class="note" id="beta-note">The TestFlight invite is coming soon. Play in the browser meanwhile.</p>}
      </div>
      <PhoneShot src={homeShot} alt="The DoYouKnow home screen with the daily card and friends" eager />
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Three steps. One minute a day.</h2>
      <div class="cards">
        {steps.map((step, i) => (
          <div class="card">
            <span class="num">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="screens">
    <div class="wrap">
      <p class="eyebrow">Inside the app</p>
      <h2>See how it plays.</h2>
    </div>
    <div class="gallery" role="region" aria-label="App screenshots" tabindex="0">
      {screens.map((screen) => (
        <figure>
          <PhoneShot src={screen.src} alt={screen.alt} />
          <figcaption><strong>{screen.title}</strong><span>{screen.text}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="wrap note">Screenshots show the app in German, with demo data.</p>
  </section>

  <section id="plans">
    <div class="wrap">
      <p class="eyebrow">Plans</p>
      <h2>Free during the beta.</h2>
      <p class="free-banner lead">Paid tiers are planned. Nothing to buy today.</p>
      <div class="cards">
        {plans.map((plan) => (
          <div class="card">
            <h3>{plan.name}</h3>
            <p>{plan.text}</p>
            <span class="tag">Coming soon</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h2>An indie project.</h2>
      <p class="lead">Made by Moritz Götz.</p>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <p class="eyebrow">FAQ</p>
      <h2>Good to know.</h2>
      <Faq />
    </div>
  </section>

  <section id="support">
    <div class="wrap">
      <p class="eyebrow">Support</p>
      <h2>Questions? Write us.</h2>
      <SupportButton />
    </div>
  </section>
</Base>
