---
import '../styles/global.css';
import Background from '../components/Background.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../data/links';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object;
}
const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = `${SITE_URL}/og.png`;
const onHome = Astro.url.pathname === '/';
const anchor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07070d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DoYouKnow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Background />
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/"><img src="/favicon.svg" alt="" width="28" height="28" />DoYouKnow</a>
        <ul>
          <li><a href={anchor('how')}>How it works</a></li>
          <li><a href={anchor('plans')}>Plans</a></li>
          <li><a href={anchor('about')}>About</a></li>
          <li><a href={anchor('faq')}>FAQ</a></li>
        </ul>
      </div>
    </header>
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
